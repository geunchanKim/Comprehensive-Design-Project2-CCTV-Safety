POSTGRES_USER=cctv_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cctv_safety_db

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

BACKEND_PORT=8000
PGADMIN_PORT=5050
MAX_SYNC_DELTA_MS=50
MAX_EPIPOLAR_ERROR_PX=50
BOX_FOOT_Z_MIN=-0.35
BOX_FOOT_Z_MAX=0.2
ANKLE_FOOT_Z_MIN=-0.1
ANKLE_FOOT_Z_MAX=0.4
BBOX_POSITION_METHOD=triangulate
MAX_GROUND_DISTANCE_M=2.0
ENABLE_KALMAN_FILTER=true
ENABLE_TRACK_PAIR_HOLD=true
TRACK_PAIR_CONFIRM_FRAMES=3
TRACK_PAIR_IMPROVEMENT_RATIO=0.9
ENABLE_RISK_ANALYSIS=false
ENABLE_ANKLE_PAIRING=true
# improved에 켤 기능 글자 (c 바닥추적, d 한카메라, f 경고유지, g 바닥 짝짓기). 비우면 예전 방식(ENABLE_*)
IMPROVED_FEATURES=cdfg
MIN_ANKLE_CONFIDENCE=0.6
WARNING_DISTANCE_M=1.0
DANGER_DISTANCE_M=0.5

# 배포 시 현재 Git 커밋으로 덮어씁니다.
APP_COMMIT_SHA=unknown
